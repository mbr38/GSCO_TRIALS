{# M-P11.2 shared shell for all report templates. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  /* Print-friendly base styles (weasyprint compat in M-P11.3). */
  @page {
    size:    A4;
    margin:  20mm 18mm;
    @bottom-center {
      content: "GSCO Environmental Monitoring — page " counter(page);
      font-size: 9pt; color: #6b7280;
    }
  }
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
         color: #1f2937; line-height: 1.45; }
  h1   { font-size: 22pt; margin: 0 0 4mm 0; color: #111827; }
  h2   { font-size: 16pt; margin: 8mm 0 3mm 0; color: #111827;
         border-bottom: 1px solid #e5e7eb; padding-bottom: 2mm; }
  h3   { font-size: 12pt; margin: 5mm 0 2mm 0; color: #1f2937; }
  .meta-grid { display: grid; grid-template-columns: max-content 1fr;
               gap: 2mm 6mm; font-size: 10pt; margin: 4mm 0; }
  .meta-label { color: #6b7280; }
  .pillar-chip { display: inline-block; padding: 1mm 3mm;
                 border-radius: 3px; font-weight: 600; }
  .pillar-chip.red    { background: #fee2e2; color: #991b1b; }
  .pillar-chip.amber  { background: #fef3c7; color: #92400e; }
  .pillar-chip.green  { background: #d1fae5; color: #065f46; }
  .pillar-chip.grey   { background: #f3f4f6; color: #6b7280; }
  table { width: 100%; border-collapse: collapse; margin: 3mm 0;
          font-size: 10pt; }
  th, td { padding: 1.5mm 2mm; text-align: left;
           border-bottom: 1px solid #e5e7eb; }
  th { background: #f9fafb; font-weight: 600; }
  .chapter-break { page-break-before: always; }
  .caveat { background: #fef3c7; padding: 3mm; border-radius: 3px;
            font-size: 9pt; margin: 3mm 0; }
</style>
</head>
<body>
  {{ sections_html | safe }}
</body>
</html>
