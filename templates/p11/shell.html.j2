{# M-P11.2 shared shell for all report templates. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  /* Print-friendly base styles (weasyprint compat in M-P11.3). */
  @page {
    size:    A4;
    margin:  20mm 18mm;
    @bottom-center {
      content: "GSCO Environmental Monitoring — page " counter(page);
      font-size: 9pt; color: #6b7280;
    }
  }
  /* color-scheme: light pins the iframe's UA colors to light mode so
     Streamlit's dark parent page doesn't bleed in via inherited
     color-scheme. background ensures the report reads as a printed
     page floating on the dark app shell (and is harmless under PDF
     export — paper is white anyway). */
  html { color-scheme: light; }
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
         color: #1f2937; background: #ffffff; line-height: 1.45;
         margin: 0; padding: 16px 24px; }
  /* M-REPORT-A1.1 (RF1) — report-template identity on the cover. */
  .report-type { font-size: 11pt; font-weight: 600; letter-spacing: 0.4px;
                 text-transform: uppercase; color: #2563eb; margin: 0 0 2mm 0; }
  h1   { font-size: 22pt; margin: 0 0 4mm 0; color: #111827; }
  h2   { font-size: 16pt; margin: 8mm 0 3mm 0; color: #111827;
         border-bottom: 1px solid #e5e7eb; padding-bottom: 2mm; }
  h3   { font-size: 12pt; margin: 5mm 0 2mm 0; color: #1f2937; }
  .meta-grid { display: grid; grid-template-columns: max-content 1fr;
               gap: 2mm 6mm; font-size: 10pt; margin: 4mm 0; }
  .meta-label { color: #6b7280; }
  .pillar-chip { display: inline-block; padding: 1mm 3mm;
                 border-radius: 3px; font-weight: 600; }
  .pillar-chip.red    { background: #fee2e2; color: #991b1b; }
  .pillar-chip.amber  { background: #fef3c7; color: #92400e; }
  .pillar-chip.green  { background: #d1fae5; color: #065f46; }
  .pillar-chip.grey   { background: #f3f4f6; color: #6b7280; }
  table { width: 100%; border-collapse: collapse; margin: 3mm 0;
          font-size: 10pt; }
  th, td { padding: 1.5mm 2mm; text-align: left;
           border-bottom: 1px solid #e5e7eb; }
  th { background: #f9fafb; font-weight: 600; }
  .chapter-break { page-break-before: always; }
  .caveat { background: #fef3c7; padding: 3mm; border-radius: 3px;
            font-size: 9pt; margin: 3mm 0; }
  h4   { font-size: 11pt; margin: 4mm 0 2mm 0; color: #1f2937; }
  /* M-REPORT-A1 — ESRS framing layer (RT4). */
  .esrs-topic { margin: 4mm 0 6mm 0; }
  .esrs-intro { font-size: 9.5pt; color: #374151; margin: 1mm 0 2mm 0; }
  .esrs-out-of-scope { background: #f3f4f6; border-left: 3px solid #9ca3af;
                       padding: 2mm 3mm; margin: 3mm 0; font-size: 9pt; }
  .esrs-out-of-scope h4 { margin: 0 0 1mm 0; font-size: 10pt; }
  .oos-tag { display: inline-block; margin-left: 2mm; padding: 0.5mm 2mm;
             background: #e5e7eb; color: #4b5563; border-radius: 3px;
             font-size: 8pt; font-weight: 600; text-transform: uppercase;
             letter-spacing: 0.3px; vertical-align: middle; }
  /* M-REPORT-A1 — trend report pillar grouping (RT10, grouping only). */
  .pillar-group { border-bottom: 1px solid #e5e7eb; padding-bottom: 1mm; }
  /* M-REPORT-A1.1 — composite-formula appendix. */
  .formula { background: #f9fafb; border-left: 3px solid #2563eb;
             padding: 2mm 3mm; font-size: 11pt; }
  /* M-REPORT-A1 — content-aware glossary appendix (RT12/RT13). */
  .glossary-list { margin: 2mm 0 4mm 0; font-size: 10pt; }
  .glossary-list dt { font-weight: 600; color: #111827; margin-top: 2mm; }
  .glossary-list dd { margin: 0 0 1mm 0; color: #374151; }
</style>
</head>
<body>
  {{ sections_html | safe }}
</body>
</html>
