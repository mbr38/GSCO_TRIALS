# Template for the secrets used by the DEPLOYED app.
#
# On Streamlit Community Cloud: paste this content (with real values) into the
# app's Settings -> Secrets box. You do NOT commit real secrets.
#
# Locally: copy this file to `.streamlit/secrets.toml` and fill it in ONLY if
# you want to test the deployed code paths (service-account EE auth + password
# gate) on your laptop. Normal local development needs none of this — leave the
# secrets file absent and the app uses `earthengine authenticate` + no gate.
#
# `.streamlit/secrets.toml` is gitignored; this `.example` is safe to commit.

EE_PROJECT_ID  = "supply-chain-observatory"
OPENAQ_API_KEY = "your-openaq-key-here"
APP_PASSWORD   = "choose-a-strong-password"

# Earth Engine service account: paste the ENTIRE downloaded JSON key file here,
# unchanged, between the triple-quote markers. No field-by-field editing, no
# newline surgery on the private key.
EE_SERVICE_ACCOUNT_JSON = '''
{
  "type": "service_account",
  "project_id": "supply-chain-observatory",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "gsco-ee@supply-chain-observatory.iam.gserviceaccount.com",
  "client_id": "...",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/...",
  "universe_domain": "googleapis.com"
}
'''
